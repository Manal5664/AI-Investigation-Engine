# EvidenceAI - SAFE demo-mode configuration.
#
# Load this file instead of your personal .env to run the app fully offline:
#
#   $env:APP_ENV_FILE = "examples/demo.env"
#   python -m uvicorn app.main:app
#
# The file is intentionally committed so a reviewer can reproduce the demo
# without any API key. It makes no external or billable calls. Results are
# generated by the deterministic mock providers and are labeled as mock data
# in every API response (provider_used / model_used).

ENVIRONMENT=development
DEBUG=false

APP_NAME=EvidenceAI (demo)
APP_VERSION=0.6.0

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOWED_ORIGINS=

# AI providers - every provider is pinned to the offline mock implementation.
# No Gemini API key is required and none should be present.
LLM_PROVIDER=mock
LLM_MODEL=mock-investigator
LLM_TIMEOUT_SECONDS=60

EVIDENCE_PROVIDER=mock
EVIDENCE_MODEL=mock-evidence-v1
EVIDENCE_INCLUDE_DOCUMENTS=false

SEARCH_PROVIDER=mock
SEARCH_MODEL=mock-search-v1
SEARCH_MAX_RESULTS=5

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
VECTOR_STORE_PROVIDER=in_memory
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

GRAPH_STORE_PROVIDER=in_memory
GRAPH_EXTRACTION_PROVIDER=mock
GRAPH_EXTRACTION_MODEL=mock-graph-extractor

DOCUMENT_STORE_PROVIDER=in_memory
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=50
DOCUMENT_MAX_PER_REQUEST=10
VISION_PROVIDER=mock
VISION_MODEL=mock-vision-v1

# In-memory persistence: every investigation, user, and document lives in the
# process and is cleared on restart. A relational database is not required.
PERSISTENCE_PROVIDER=in_memory
DATABASE_URL=
DATABASE_ECHO=false

# IMPORTANT - the agentic, end-to-end research, web-research, and UI "Run
# investigation" endpoints select their search provider from SEARCH_PROVIDER
# above. With SEARCH_PROVIDER=mock this file runs those endpoints fully offline
# on reserved *.example domains; setting SEARCH_PROVIDER=gemini_grounded would
# require a real GEMINI_API_KEY. See docs/demo-mode.md for details.
