# Environment selector: development (default), testing, or production.
# Production enforces safe configuration at startup (see validate_production_configuration).
ENVIRONMENT=development
DEBUG=false

APP_NAME=AI Investigation Engine
APP_VERSION=0.6.0

# Server bind settings. Development defaults keep uvicorn on localhost.
# Production should set HOST=0.0.0.0 and PORT (many platforms inject PORT).
HOST=127.0.0.1
PORT=8000

# Logging. LOG_LEVEL is one of DEBUG/INFO/WARNING/ERROR.
# Set LOG_JSON=true for single-line JSON records in production log aggregators.
LOG_LEVEL=INFO
LOG_JSON=false

# CORS. Comma-separated list of explicit origins, e.g. https://app.example.com.
# Keep empty when the browser UI is served by this same FastAPI application
# (same-origin requests need no CORS). Never default production to "*".
CORS_ALLOWED_ORIGINS=

LLM_PROVIDER=mock
LLM_MODEL=mock-investigator
LLM_TIMEOUT_SECONDS=60

# To enable Gemini, set LLM_PROVIDER=gemini and choose a stable Gemini model.
# Example: LLM_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

EVIDENCE_PROVIDER=mock
EVIDENCE_MODEL=gemini-3.6-flash

# Set to true so evidence extraction also reads page excerpts from stored
# documents (requires the document subsystem and optional RAG).
EVIDENCE_INCLUDE_DOCUMENTS=false

SEARCH_PROVIDER=mock
SEARCH_MODEL=gemini-3.6-flash
SEARCH_MAX_RESULTS=5

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
VECTOR_STORE_PROVIDER=in_memory
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Document management subsystem
DOCUMENT_STORE_PROVIDER=in_memory
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=50
DOCUMENT_MAX_PER_REQUEST=10
VISION_PROVIDER=mock
VISION_MODEL=gemini-3.6-flash

# Persistence (Phase 10)
# PERSISTENCE_PROVIDER=in_memory keeps everything in memory (test/development
# fallback). Set to sqlalchemy to persist users, investigations, audit steps,
# documents, sources, evidence, conflicts, and reports in a database.
PERSISTENCE_PROVIDER=in_memory
# PostgreSQL (real use) or SQLite (local/testing fallback).
# PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://investigator:CHANGE_ME@localhost:5432/ai_investigation
# SQLite example (automated tests and quick local runs):
#   DATABASE_URL=sqlite:///./ai_investigation.db
# PRODUCTION REQUIREMENTS:
#   - ENVIRONMENT=production requires PERSISTENCE_PROVIDER=sqlalchemy with a
#     PostgreSQL DATABASE_URL. In-memory persistence and SQLite are rejected.
#   - Never put a real password in a committed file; supply it through the
#     process environment or a secret manager.
DATABASE_URL=
# Log emitted SQL when true; leave false in production.
DATABASE_ECHO=false

# Browser UI case workspace
# The browser UI is a thin layer over the same pluggable providers as /api/v1:
# PERSISTENCE_PROVIDER, DOCUMENT_STORE_PROVIDER, GRAPH_STORE_PROVIDER, and
# VECTOR_STORE_PROVIDER. There is no separate UI database or worker.
