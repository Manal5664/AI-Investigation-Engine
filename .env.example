APP_NAME=AI Investigation Engine
APP_VERSION=0.6.0
ENVIRONMENT=development
DEBUG=false

LLM_PROVIDER=mock
LLM_MODEL=mock-investigator
LLM_TIMEOUT_SECONDS=60

# To enable Gemini, set LLM_PROVIDER=gemini and choose a stable Gemini model.
# Example: LLM_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

EVIDENCE_PROVIDER=mock
EVIDENCE_MODEL=gemini-3.6-flash

SEARCH_PROVIDER=mock
SEARCH_MODEL=gemini-3.6-flash
SEARCH_MAX_RESULTS=5

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
VECTOR_STORE_PROVIDER=in_memory
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
